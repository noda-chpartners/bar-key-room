---
const instagramUrl = '#';
---

<footer class="footer">
  <div class="footer__inner">
    <a class="footer__brand site-link" href="#top" aria-label="ページ上部へ戻る">
      <img class="footer__logo site-image" src="/assets/logo-sample.png" alt="Bar サンプル" width="725" height="2167" loading="lazy" />
    </a>
    <div class="footer__meta">
      <p class="footer__address">サンプル県サンプル市サンプル町1-2-3 サンプルビル1F</p>
      <a class="footer__instagram site-link" href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a>
    </div>
    <p class="footer__credit">BAR SAMPLE</p>
  </div>
</footer>

<style lang="scss">
  @use "../styles/tokens" as *;
  @use "../styles/mixins" as *;

  .footer {
    position: relative;
    padding: clamp(90px, 12vw, 170px) 0 44px;
    overflow: hidden;
    border-top: 1px solid rgba($color-brass-light, 0.16);
    background: $color-ink;
  }

  .footer__inner {
    @include section-shell;
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: end;
    gap: 48px;
  }

  .footer__brand {
    width: 58px;
  }

  .footer__logo {
    height: auto;
  }

  .footer__meta {
    display: flex;
    gap: 28px;
    color: $color-muted;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    line-height: 1.8;
  }

  .footer__instagram {
    @include interactive-line;
    color: $color-brass-light;
    font-family: $font-sans;
  }

  .footer__credit {
    color: rgba($color-paper, 0.36);
    font-family: $font-sans;
    font-size: 0.54rem;
    letter-spacing: 0.28em;
  }

  @include media-mobile {
    .footer {
      padding-top: 80px;
    }

    .footer__inner {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 36px;
    }

    .footer__brand {
      width: 44px;
    }

    .footer__meta {
      flex-direction: column;
      gap: 16px;
    }
  }
</style>
