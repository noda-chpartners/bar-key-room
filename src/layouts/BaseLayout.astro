---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  keywords = 'Bar サンプル,隠れ家バー,サンプル',
  ogImage = '/assets/ogp.png',
  noindex = false,
} = Astro.props;

const site = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImageURL = new URL(ogImage, site);
const siteName = 'Bar サンプル';
const locale = 'ja_JP';
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${canonicalURL.origin}/#website`,
      url: canonicalURL.origin,
      name: siteName,
      description,
      inLanguage: 'ja',
      publisher: { '@id': `${canonicalURL.origin}/#bar` },
    },
    {
      '@type': 'BarOrPub',
      '@id': `${canonicalURL.origin}/#bar`,
      name: siteName,
      alternateName: ['サンプル', 'Bar Sample'],
      description,
      url: canonicalURL.href,
      image: ogImageURL.href,
      priceRange: '¥¥',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'サンプル町1-2-3 サンプルビル1F',
        addressLocality: 'サンプル市',
        addressRegion: 'サンプル県',
        addressCountry: 'JP',
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
          opens: '18:00',
          closes: '23:00',
        },
      ],
      sameAs: ['#'],
      hasMap: '#',
    },
  ],
};
---

<!doctype html>
<html class="site-root" lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="author" content={siteName} />
    <meta name="generator" content={Astro.generator} />
    <meta name="format-detection" content="telephone=no, email=no, address=no" />
    <meta name="theme-color" content="#090908" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonicalURL.href} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:secure_url" content={ogImageURL.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    <meta property="og:image:alt" content={`${siteName} のロゴ`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <meta name="twitter:image:alt" content={`${siteName} のロゴ`} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="site-body is-loading">
    <slot />
  </body>
</html>
