---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroSection from '../components/HeroSection.astro';
import ConceptSection from '../components/ConceptSection.astro';
import SpaceSection from '../components/SpaceSection.astro';
import MenuSection from '../components/MenuSection.astro';
import InformationSection from '../components/InformationSection.astro';
import SiteFooter from '../components/SiteFooter.astro';

const title = 'Bar サンプル｜隠れ家バー';
const description =
  '植物と木のぬくもりに包まれた隠れ家バー「Bar サンプル」。営業時間やアクセスなどの店舗情報は仮の内容です。';
---

<BaseLayout title={title} description={description}>
  <SiteHeader />
  <main class="site-main">
    <HeroSection />
    <ConceptSection />
    <SpaceSection />
    <MenuSection />
    <InformationSection />
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  import '../scripts/animations.js';
</script>
